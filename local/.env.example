# Copy to local/.env. Loaded by the backend (backend/config.py) before any handler is imported.

# --- Storage -----------------------------------------------------------------
# SQLite database (app.db) and video files live under this directory.
# Default: <repo>/data
#DATA_DIR=
S3_BUCKET=video-eval-local
VIDEO_UPLOAD_S3_PREFIX=upload
S3_PRESIGNED_URL_EXPIRY_S=3600
# URLs handed to the browser for uploads/downloads. Must be reachable from the browser.
#PUBLIC_BASE_URL=http://localhost:8080
# Optional: fixed secret for signed file URLs (auto-generated into DATA_DIR if unset)
#FILE_SIGNING_SECRET=

# --- Table names (same as deployment/eval_service/constant.py) ---------------
DYNAMO_VIDEO_TABLE=bedrock_video_eval_video
DYNAMO_VIDEO_ANALYZE_TABLE=bedrock_video_eval_analyze_table
DYNAMO_GROUND_TRUTH_TABLE=bedrock_video_eval_ground_truth
DYNAMO_EVALUATION_TASK_TABLE=bedrock_video_eval_evaluation_task
DYNAMO_VIDEO_USAGE_TABLE=video_eval_usage

# --- Models (default provider: NVIDIA NIM, OpenAI-compatible) --------------------
# Brev secure link, `brev port-forward` (http://localhost:8000/v1), LAN host, or build.nvidia.com
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Only needed for build.nvidia.com / protected endpoints
NIM_API_KEY=
# Override which model ids the default entries in models.yaml use
#NIM_VIDEO_MODEL=nvidia/nemotron-nano-12b-v2-vl
#NIM_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
# Embeddings: Qwen3-VL-Embedding-8B on the Brev instance military-tan-rook (via `brev port-forward military-tan-rook -p 8011:8001`)
EMBED_BASE_URL=http://localhost:8011/v1

# Omni-Embed-Nemotron-3B on the Brev instance omni-embed (via `brev port-forward omni-embed -p 8002:8002`)
OMNI_EMBED_BASE_URL=http://localhost:8002

# Optional second provider: any OpenAI-compatible server
#OPENAI_COMPAT_BASE_URL=
#OPENAI_COMPAT_API_KEY=

# --- Server ------------------------------------------------------------------
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:5173
# Max concurrent async ("Event") handler invocations, replacing Lambda concurrency
LOCAL_INVOKE_WORKERS=4
# Identity injected as the Cognito username (single-user local mode)
LOCAL_USERNAME=local-user
